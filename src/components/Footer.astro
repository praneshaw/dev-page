---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer
  id="contact"
  class="py-20 border-t border-neutral-200 dark:border-neutral-800"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
    <h2 class="text-2xl font-bold mb-6 flex items-center justify-center gap-3">
      <span class="text-neutral-400 font-mono text-xl">03.</span>
      {t("contact.title")}
    </h2>

    <p
      class="text-neutral-600 dark:text-neutral-400 max-w-lg mx-auto mb-10 leading-relaxed"
    >
      {t("contact.message")}
    </p>

    <a
      href="mailto:praneshawahyu@gmail.com"
      class="inline-block px-6 py-3 border border-neutral-900 dark:border-neutral-100 text-neutral-900 dark:text-neutral-100 hover:bg-neutral-900 hover:text-white dark:hover:bg-neutral-100 dark:hover:text-neutral-900 transition-colors rounded-md font-mono text-sm mb-16"
    >
      {t("contact.email")}
    </a>

    <div class="flex justify-center gap-6 font-mono text-sm">
      <a
        href="https://github.com/praneshaw"
        target="_blank"
        rel="noopener noreferrer"
        class="text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors"
      >
        GitHub
      </a>
      <a
        href="https://linkedin.com/in/praneshaw"
        target="_blank"
        rel="noopener noreferrer"
        class="text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors"
      >
        LinkedIn
      </a>
      <a
        href="https://instagram.com/shranepa"
        target="_blank"
        rel="noopener noreferrer"
        class="text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors"
      >
        Instagram
      </a>
    </div>
  </div>
</footer>
