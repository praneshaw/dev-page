---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

type LangKey = "en" | "id";
const currentLang = lang as LangKey;

const experiences = [
  {
    role: {
      en: "What's next.....",
      id: "Apa selanjutnya.....",
    },
    company: "Soon.....",
    period: {
      en: "Now",
      id: "Sekarang",
    },
    desc: {
      en: "Stay tuned for more details...",
      id: "Tetap pantau untuk detail lebih lanjut...",
    },
  },
  {
    role: {
      en: "Backend Engineer",
      id: "Backend Engineer",
    },
    company: "CV Wangun Teknologi Bersama",
    period: {
      en: "2020 - 2026",
      id: "2020 - 2026",
    },
    desc: {
      en: "Lead the backend development for a new website CMS platform, building a scalable architecture from scratch. Optimized database design and implemented efficient caching strategies to support multiple tenants and handle high-volume traffic.",
      id: "Memimpin pengembangan backend untuk platform CMS website baru, membangun arsitektur yang scalable dari nol. Mengoptimalkan desain basis data dan mengimplementasikan strategi caching yang efisien untuk mendukung berbagai tenant dan menangani lalu lintas bervolume tinggi.",
    },
  },
];
---

<section
  id="experience"
  class="py-20 border-t border-neutral-200 dark:border-neutral-800"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    <h2 class="text-2xl font-bold mb-12 flex items-center gap-3">
      <span class="text-neutral-400 font-mono text-xl">02.</span>
      {t("experience.title")}
    </h2>

    <div class="space-y-12">
      {
        experiences.map((exp) => (
          <div class="relative pl-6 sm:pl-0">
            <div class="hidden sm:block absolute left-[120px] top-2 w-px h-full bg-neutral-200 dark:bg-neutral-800" />
            <div class="hidden sm:block absolute left-[116px] top-2.5 w-2 h-2 rounded-full bg-neutral-400 dark:bg-neutral-600" />

            <div class="flex flex-col sm:flex-row gap-2 sm:gap-16">
              <div class="font-mono text-sm text-neutral-500 sm:w-[100px] shrink-0 pt-1">
                {exp.period[currentLang]}
              </div>
              <div>
                <h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100">
                  {exp.role[currentLang]}
                </h3>
                <div class="text-neutral-500 mb-3">{exp.company}</div>
                <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed text-sm">
                  {exp.desc[currentLang]}
                </p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
